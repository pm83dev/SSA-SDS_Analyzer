{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=sds_db;User Id=YOUR_USER;Password=YOUR_PASSWORD;Trust Server Certificate=true"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG!",
    "Issuer": "SSA-SDS",
    "Audience": "SSA-SDS-Client",
    "ExpirationHours": 2
  },
  "LLM": {
    "BaseUrl": "http://YOUR_LLM_SERVER:8080",
    "Model": "YOUR_MODEL_NAME",
    "ApiKey": "",
    "EmbeddingUrl": "",
    "RerankingUrl": "",
    "TimeoutSeconds": 300,
    "MaxTextChars": 60000
  },
  "FileStorage": {
    "UploadPath": "uploads",
    "MaxFileSizeMB": 20,
    "AllowedPdfExtensions": ".pdf"
  },
  "Ocr": {
    "TessdataPath": "tessdata",
    "Languages": ["ita", "eng"]
  }
}