{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=sds_db;Integrated Security=true;Trust Server Certificate=true"
  },
  "Jwt": {
    "SecretKey": "SSA-SDS-SecretKey-2024-MustBeAtLeast32CharsLong!",
    "Issuer": "SSA-SDS",
    "Audience": "SSA-SDS-Client",
    "ExpirationHours": 2
  },
  "LLM": {
    "BaseUrl": "http://localhost:8080",
    "EmbeddingUrl": "http://localhost:8081/embed",
    "RerankingUrl": "http://localhost:8082/rerank",
    "TimeoutSeconds": 120
  },
  "FileStorage": {
    "UploadPath": "uploads",
    "MaxFileSizeMB": 20,
    "AllowedPdfExtensions": ".pdf"
  }
}
