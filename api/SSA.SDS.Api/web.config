<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Disable IIS static file handling - let ASP.NET Core handle everything -->
      <staticContent>
        <remove fileExtension=".html" />
      </staticContent>
      <!-- Route all requests to ASP.NET Core -->
      <!-- Remove IIS extension handler for .config files -->
      <handlers>
        <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
        <remove name="OPTIONSVerbHandler" />
        <remove name="TRACEVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2"
          resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SSA.SDS.Api.dll" stdoutLogEnabled="true"
        stdoutLogFile=".\logs\stdout" forwardWindowsAuthToken="false" hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_URLS" value="http://*:5002" />
        </environmentVariables>
      </aspNetCore>
      <!-- Security settings -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="2147483648" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>