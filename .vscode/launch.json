{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SPA (API + Angular su :5007)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/api/SSA.SDS.Api/bin/Debug/net8.0/SSA.SDS.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api/SSA.SDS.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5007"
      },
      "preLaunchTask": "build-spa",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "API (Backend :5007)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/api/SSA.SDS.Api/bin/Debug/net8.0/SSA.SDS.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api/SSA.SDS.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5007"
      },
      "preLaunchTask": "build-api"
    },
    {
      "name": "LLM Service (Backend :9010)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/llm-service/bin/Debug/net8.0/SSA.LlmService.dll",
      "args": [],
      "cwd": "${workspaceFolder}/llm-service",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:9010"
      },
      "preLaunchTask": "build-llm"
    },
    {
      "name": "Frontend dev server (ng serve :4200, hot reload)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend/sds-frontend/src",
      "preLaunchTask": "start-frontend"
    }
  ],
  "compounds": [
    {
      "name": "SPA :5007 + LLM",
      "configurations": [
        "SPA (API + Angular su :5007)",
        "LLM Service (Backend :9010)"
      ],
      "stopAll": true
    },
    {
      "name": "Sviluppo: API + LLM + ng serve :4200",
      "configurations": [
        "API (Backend :5007)",
        "LLM Service (Backend :9010)",
        "Frontend dev server (ng serve :4200, hot reload)"
      ],
      "stopAll": true
    },
    {
      "name": "Sviluppo: API + ng serve :4200",
      "configurations": [
        "API (Backend :5007)",
        "Frontend dev server (ng serve :4200, hot reload)"
      ],
      "stopAll": true
    }
  ]
}
