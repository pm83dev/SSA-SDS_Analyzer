{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/api/SSA.SDS.Api/SSA.SDS.Api.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "build-llm",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/llm-service/SSA.LlmService.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "start-frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "start:proxy"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend/sds-frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^.*error.*$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Building...|Application bundle generation"
          },
          "endsPattern": {
            "regexp": "Local:\\s+http://localhost:4200|Application bundle generation complete|Watch mode enabled"
          }
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "build-spa-frontend",
      "detail": "Compila Angular (development) direttamente in api/SSA.SDS.Api/wwwroot",
      "type": "process",
      "command": "npx",
      "args": [
        "ng",
        "build",
        "--configuration",
        "spa"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend/sds-frontend"
      },
      "windows": {
        "command": "npx.cmd"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "build-spa",
      "detail": "Frontend in wwwroot + build API",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build-spa-frontend",
        "build-api"
      ],
      "problemMatcher": []
    }
  ]
}
